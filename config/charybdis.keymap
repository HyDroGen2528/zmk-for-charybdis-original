#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/runtime_tapdance.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Upper three rows follow HyDroGen2528/zmk-dongle-keyball39,
// V4.0-hotFixed/config/keyball39.keymap, with the approved simplifications.
// Keep the existing Nano35 thumb bindings and layer-tap timing.
&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        nano35_encoder_scroll: nano35_encoder_scroll {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            // One 16 ms mouse tick at 100 units/s produces one wheel unit.
            tap-ms = <20>;
            cw-binding = <&msc MOVE_Y(-100)>;
            ccw-binding = <&msc MOVE_Y(100)>;
        };

        nano35_encoder_none: nano35_encoder_none {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            cw-binding = <&none>;
            ccw-binding = <&none>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "BASE";
            sensor-bindings = <&nano35_encoder_scroll>;
            bindings = <
                &kp Q                   &kp W                   &kp E                   &kp R                   &kp T                       &kp Y                   &kp U                   &lt 4 I                 &lt 5 O                 &kp P
                &mt LEFT_SHIFT A        &mt LEFT_ALT S          &mt LCTRL D             &mt LEFT_GUI F          &kp G                       &kp H                   &mt RIGHT_GUI J         &mt RCTRL K             &mt RIGHT_ALT L         &mt RIGHT_SHIFT SEMI
                &kp Z                   &kp X                   &kp C                   &kp V                   &kp B                       &kp N                   &kp M                   &kp COMMA               &kp DOT                 &kp SLASH
                                                                &mkp MB1                &mkp MB2                &lt 1 ESC                   &kp SPACE               &lt 2 BACKSPACE
            >;
        };

        layer_1 {
            display-name = "NUM & ARROW";
            sensor-bindings = <&nano35_encoder_none>;
            bindings = <
                &none                   &kp NUMBER_1            &kp NUMBER_2            &kp NUMBER_3            &kp HOME                    &kp PG_UP               &none                   &kp UP_ARROW            &none                   &none
                &none                   &kp NUMBER_4            &kp N5                  &kp NUMBER_6            &kp END                     &kp PAGE_DOWN           &kp LEFT_ARROW          &kp DOWN_ARROW          &kp RIGHT_ARROW         &none
                &none                   &kp N7                  &kp N8                  &kp N9                  &kp N0                      &mkp LCLK               &mkp MCLK               &mkp RCLK               &none                   &none
                                                                &none                   &none                   &none                       &kp F11                 &kp F12
            >;
        };

        layer_2 {
            display-name = "SYMBOL";
            sensor-bindings = <&nano35_encoder_none>;
            bindings = <
                &kp EXCLAMATION         &kp AT_SIGN             &kp HASH                &kp DOLLAR              &kp PERCENT                 &kp CARET               &kp AMPERSAND           &kp ASTERISK            &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS
                &none                   &none                   &none                   &none                   &none                       &kp MINUS               &kp EQUAL               &kp LEFT_BRACKET        &kp RIGHT_BRACKET       &kp SQT
                &kp EQUAL               &kp PLUS                &kp MINUS               &kp ASTERISK            &kp SLASH                   &kp UNDERSCORE          &kp PLUS                &none                   &none                   &kp NON_US_BACKSLASH
                                                                &none                   &none                   &none                       &none                   &none
            >;
        };

        layer_3 {
            display-name = "FUNCTION";
            sensor-bindings = <&nano35_encoder_none>;
            bindings = <
                &kp F1                  &kp F2                  &kp F3                  &kp F4                  &kp F5                      &none                   &none                   &none                   &none                   &none
                &kp F6                  &kp F7                  &kp F8                  &kp F9                  &kp F10                     &none                   &none                   &none                   &none                   &none
                &kp F11                 &kp F12                 &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                                                                &none                   &none                   &none                       &none                   &none
            >;
        };

        layer_4 {
            display-name = "MOUSE";
            sensor-bindings = <&nano35_encoder_none>;
            bindings = <
                &kp N1                  &kp N2                  &kp N3                  &kp N4                  &kp N5                      &kp N6                  &kp N7                  &kp N8                  &kp N9                  &kp N0
                &none                   &none                   &none                   &none                   &kp HOME                    &kp PAGE_UP             &mkp LCLK               &mkp MCLK               &mkp RCLK               &none
                &none                   &none                   &none                   &none                   &kp END                     &kp PAGE_DOWN           &none                   &none                   &none                   &none
                                                                &none                   &none                   &none                       &none                   &none
            >;
        };

        layer_5 {
            display-name = "L5";
            sensor-bindings = <&nano35_encoder_none>;
            bindings = <
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                                                                &none                   &none                   &none                       &none                   &none
            >;
        };

        layer_6 {
            display-name = "L6";
            sensor-bindings = <&nano35_encoder_none>;
            bindings = <
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                &none                   &none                   &none                   &none                   &none                       &none                   &mkp LCLK               &mkp MCLK               &mkp RCLK               &none
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                                                                &none                   &none                   &none                       &none                   &none
            >;
        };

        layer_7 {
            display-name = "L7";
            sensor-bindings = <&nano35_encoder_none>;
            bindings = <
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                                                                &none                   &none                   &none                       &none                   &none
            >;
        };

        layer_8 {
            display-name = "L8";
            sensor-bindings = <&nano35_encoder_none>;
            bindings = <
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                                                                &none                   &none                   &none                       &none                   &none
            >;
        };

        layer_9 {
            display-name = "L9";
            sensor-bindings = <&nano35_encoder_none>;
            bindings = <
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                                                                &none                   &none                   &none                       &none                   &none
            >;
        };

        layer_10 {
            display-name = "L10";
            sensor-bindings = <&nano35_encoder_none>;
            bindings = <
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                &none                   &none                   &none                   &none                   &none                       &none                   &none                   &none                   &none                   &none
                                                                &none                   &none                   &none                       &none                   &none
            >;
        };
    };
};
