@@ -288,0 +297,17 @@
+/* A saturated queue must reject a request, never execute a different request
+ * under its ID. This path decodes the ID only; no device operation is run. */
+static void reject_pmw_relay_request(const struct zmk_pmw3610_relay_request *request) {
+    cormoran_pmw3610_RelayRequest decoded = cormoran_pmw3610_RelayRequest_init_zero;
+    pb_istream_t stream = pb_istream_from_buffer(request->payload, request->size);
+    if (!pb_decode(&stream, cormoran_pmw3610_RelayRequest_fields, &decoded)) {
+        return;
+    }
+    cormoran_pmw3610_RelayResponse response = cormoran_pmw3610_RelayResponse_init_zero;
+    response.request_id = decoded.request_id;
+    response.has_response = true;
+    response.response.which_response_type = cormoran_pmw3610_Response_error_tag;
+    snprintf(response.response.response_type.error.message,
+             sizeof(response.response.response_type.error.message), "PMW3610 relay busy; retry");
+    send_pmw_relay_response(&response);
+}
