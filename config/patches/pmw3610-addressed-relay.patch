+    }
+    if (k_msgq_put(&nano35_pmw_requests, ev, K_NO_WAIT) != 0) {
+        LOG_WRN("PMW3610 relay request queue full");
+        reject_pmw_relay_request(ev);
+        return ZMK_EV_EVENT_HANDLED;
+    }
