+static void reject_watchdog_relay_request(const struct zmk_watchdog_relay_request *request) {
+    cormoran_watchdog_RelayRequest decoded = cormoran_watchdog_RelayRequest_init_zero;
+    pb_istream_t stream = pb_istream_from_buffer(request->payload, request->size);
+    if (!pb_decode(&stream, cormoran_watchdog_RelayRequest_fields, &decoded)) {
+        return;
+    }
+    cormoran_watchdog_RelayResponse response = cormoran_watchdog_RelayResponse_init_zero;
