+    response.which_relay_response_type = cormoran_watchdog_RelayResponse_response_tag;
+    cormoran_watchdog_RelayNonListResponse *error = &response.relay_response_type.response;
+    error->which_relay_non_list_response_type = cormoran_watchdog_RelayNonListResponse_error_tag;
+    snprintf(error->relay_non_list_response_type.error.message,
+             sizeof(error->relay_non_list_response_type.error.message), "Watchdog relay busy; retry");
+    raise_relay_response(&response);
+}
