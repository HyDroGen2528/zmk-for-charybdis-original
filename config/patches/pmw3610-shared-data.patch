+/* Nano35 shares MOSI and MISO. Keep address and receive phases separate,
+ * with GPIO chip select held across them, as in the original working driver.
+ * The nRF SPIM driver does not implement SPI_HALF_DUPLEX. */
+static int nano35_read_transaction(const struct device *dev, uint8_t addr,
+                                   const struct spi_buf_set *rx) {
+    const struct pixart_config *cfg = dev->config;
+    struct spi_config bus = cfg->spi.config;
+    bus.cs.gpio.port = NULL;
+    const struct spi_buf tx_buf = {.buf = &addr, .len = 1};
+    const struct spi_buf_set tx = {.buffers = &tx_buf, .count = 1};
+    int err = gpio_pin_set_dt(&cfg->spi.config.cs.gpio, 1);
+    if (err < 0) {
+        return err;
+    }
+    k_busy_wait(1);
+    err = spi_write(cfg->spi.bus, &bus, &tx);
+    if (!err) {
+        k_busy_wait(4);
+        err = spi_read(cfg->spi.bus, &bus, rx);
+    }
+    int release_err = gpio_pin_set_dt(&cfg->spi.config.cs.gpio, 0);
+    k_busy_wait(1);
+    return err ? err : release_err;
+}
