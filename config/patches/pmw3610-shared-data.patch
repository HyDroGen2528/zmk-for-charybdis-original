+/* Caller owns data->lock. Preserve unsent counts, including queue-full and
+ * clamped reports, and flush the final sample even when motion has stopped. */
+static void nano35_flush_report_locked(const struct device *dev) {
+    struct pixart_data *data = dev->data;
+    const struct pixart_config *config = dev->config;
+    if (!data->dx && !data->dy) {
+        return;
+    }
+    int64_t now = k_uptime_get();
+    uint32_t interval = data->runtime.report_interval_min_ms;
+    int64_t wait = data->last_rpt_time + interval - now;
+    if (wait > 0) {
+        nano35_schedule_report(dev, wait);
+        return;
+    }
+    int16_t x = CLAMP(data->dx, INT16_MIN, INT16_MAX);
+    int16_t y = CLAMP(data->dy, INT16_MIN, INT16_MAX);
+    bool sent = false;
+    if (x && input_report(dev, config->evt_type, config->x_input_code, x, !y, K_NO_WAIT) == 0) {
+        data->dx -= x;
+        sent = true;
+    }
+    if (y && input_report(dev, config->evt_type, config->y_input_code, y, true, K_NO_WAIT) == 0) {
+        data->dy -= y;
+        sent = true;
+    }
+    if (sent) {
+        data->last_rpt_time = now;
+    }
+    if (data->dx || data->dy) {
+        nano35_schedule_report(dev, MAX(interval, 1));
+    }
+}
