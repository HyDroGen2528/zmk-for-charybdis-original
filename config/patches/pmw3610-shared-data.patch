+/* Per-device delayed report state without changing the pinned driver's ABI. */
+struct nano35_report_state {
+    const struct device *dev;
+    struct k_work_delayable work;
+    atomic_t motion_pending;
+    atomic_t activity_pending;
+};
+
+static struct nano35_report_state nano35_reports[DT_NUM_INST_STATUS_OKAY(DT_DRV_COMPAT)];
+static void nano35_report_work(struct k_work *work);
+
+static struct nano35_report_state *nano35_report_state(const struct device *dev) {
+    for (size_t i = 0; i < ARRAY_SIZE(nano35_reports); i++) {
+        if (nano35_reports[i].dev == dev) {
+            return &nano35_reports[i];
+        }
+    }
+    return NULL;
+}
+
+static void nano35_schedule_report(const struct device *dev, int64_t delay_ms) {
+    struct nano35_report_state *state = nano35_report_state(dev);
+    if (state) {
+        k_work_reschedule(&state->work, K_MSEC(MAX(delay_ms, 1)));
+    }
+}
